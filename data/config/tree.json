            "children": [
              {"id": "progression", "label": "Rank progress", "kind": "detail", "settings": ["showPvPProgression"]},
              {"id": "campaign_rewards", "label": "Campaign rewards", "kind": "detail", "settings": ["showCampaignRewards"]},
              {"id": "leaderboards", "label": "Leaderboards", "kind": "detail", "settings": ["showLeaderboards"]},
              {"id": "battlegrounds", "label": "Battlegrounds", "kind": "detail", "settings": ["showBattlegrounds"]},
              {"id": "detailed", "label": "Everything", "kind": "detail", "settings": ["showDetailedPvP"]}
            ]},
