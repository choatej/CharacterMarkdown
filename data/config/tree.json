            "description": "Health, magicka, stamina, power, critical chance."},
           {"id": "advanced", "label": "Advanced stats", "settings": ["includeAdvancedStats"], "topics": ["stats.advanced"],
            "description": "Core abilities, resistances, damage bonuses."},
