            "children": [
              {"id": "analysis", "label": "Detailed analysis", "kind": "detail", "settings": ["showEquipmentAnalysis"]},
              {"id": "recommendations", "label": "Recommendations", "kind": "detail", "settings": ["showEquipmentRecommendations"]}
            ]}
         ]},
        {"id": "stats", "label": "Combat stats",
