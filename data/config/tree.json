         ]}
      ]
    },
    {
      "id": "social", "label": "Social", "domain": "content",
      "children": [
        {"id": "guilds", "label": "Guild membership", "settings": ["includeGuilds"], "topics": ["guilds"]},
        {"id": "mail", "label": "Mail", "settings": ["includeMail"], "topics": ["mail"]}
      ]
    },
    {
      "id": "profile", "label": "Your own text", "domain": "profile",
      "description": "Free text the player writes for the reader of the export.",
      "children": [
        {"id": "build_notes", "label": "Build notes", "settings": ["includeBuildNotes"], "topics": ["customNotes"]},
        {"id": "play_style", "label": "Play style", "topics": ["playStyle"]}
      ]
    },
    {
