{
  "schema": 1,
  "description": "What a CharacterMarkdown export can contain, as a tree. Each node is something a user can switch on or off; switching a node off switches off everything under it. See data/config/README.md.",
  "not_in_tree": {
    "detectedOS": "set by the add-on from the platform, not a user choice"
  },
  "sections": [
    {
      "id": "character", "label": "Character", "domain": "content",
      "description": "Who the character is and how far along they are.",
      "children": [
        {"id": "identity", "label": "Identity", "settings": ["includeCharacterAttributes"], "topics": ["character", "characterAttributes"],
         "description": "Name, class, race, alliance, level, champion points, age, ESO Plus.",
         "children": [
           {"id": "mundus", "label": "Mundus stone", "topics": ["mundus"], "description": "Active mundus stone(s)."}
         ]},
        {"id": "location", "label": "Current location", "settings": ["includeLocation"], "topics": ["location"]},
        {"id": "role", "label": "Role", "settings": ["includeRole"], "topics": ["role"], "description": "Selected group role (tank, healer, damage)."},
        {"id": "titles", "label": "Titles", "settings": ["includeTitlesHousing"], "topics": ["titles", "titlesHousing"]},
        {"id": "housing", "label": "Housing", "settings": ["includeHousing"], "topics": ["housing"]},
        {"id": "appearance", "label": "Appearance", "settings": ["includeAppearance"], "topics": ["appearance"], "description": "Outfit, dyes, active mount and costume."},
        {"id": "dlc", "label": "DLC and chapter access", "settings": ["includeDLCAccess"], "topics": ["dlc"]},
        {"id": "companion", "label": "Companion", "settings": ["includeCompanion"], "topics": ["companion"]},
        {"id": "progression", "label": "Progression", "settings": ["includeProgression"], "topics": ["progression"],
         "description": "Unspent points, vampire and werewolf status, achievement points."},
        {"id": "riding", "label": "Riding skills", "settings": ["includeRidingSkills"], "topics": ["riding"]}
      ]
    },
    {
      "id": "build", "label": "Build", "domain": "content",
      "description": "What the character fights with.",
      "children": [
        {"id": "champion_points", "label": "Champion points", "settings": ["includeChampionPoints"], "topics": ["cp"],
         "children": [
           {"id": "diagram", "label": "Mermaid diagram", "kind": "detail", "settings": ["includeChampionDiagram"],
            "description": "A diagram of the allocation. Only the Markdown renderer draws it; the data export has nothing extra for it."}
         ]},
        {"id": "skills", "label": "Skills",
         "children": [
           {"id": "bars", "label": "Skill bars", "settings": ["includeSkillBars"], "topics": ["skillBar"]},
