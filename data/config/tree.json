         ]},
        {"id": "buffs", "label": "Active buffs", "settings": ["includeBuffs"], "topics": ["buffs"]},
        {"id": "armory", "label": "Armory builds", "settings": ["includeArmoryBuilds"], "topics": ["armoryBuilds"], "description": "Saved loadouts."}
      ]
