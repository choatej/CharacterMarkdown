            ]},
           {"id": "styles", "label": "Outfit styles", "settings": ["includeStyles"], "topics": ["styles", "crafting.styles"],
            "children": [
              {"id": "detailed", "label": "Per-style detail", "kind": "detail", "settings": ["showStylesDetailed"]}
            ]},
           {"id": "recipes", "label": "Recipes", "settings": ["includeRecipes"], "topics": ["crafting.recipes"],
            "children": [
              {"id": "detailed", "label": "Per-recipe lists", "kind": "detail", "settings": ["showRecipesDetailed"]}
            ]},
           {"id": "item_sets", "label": "Item set collection", "settings": ["includeItemSetCollection"], "topics": ["crafting.itemSetCollection"]}
         ]}
      ]
    },
    {
      "id": "collections", "label": "Collections", "domain": "content",
      "children": [
        {"id": "collectibles", "label": "Collectibles", "settings": ["includeCollectibles"], "topics": ["collectibles"],
