         ]},
        {"id": "undaunted", "label": "Undaunted pledges", "settings": ["includeUndauntedPledges"], "topics": ["undauntedPledges"]},
        {"id": "world_progress", "label": "World progress", "settings": ["includeWorldProgress"], "topics": ["worldProgress"],
         "description": "Skyshards, lorebooks, delves and zone completion."},
        {"id": "endless_dungeon", "label": "Endless Dungeon", "settings": ["includeEndlessDungeon"]},
        {"id": "pvp", "label": "PvP",
